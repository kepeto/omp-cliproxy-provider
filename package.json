{
  "name": "omp-cliproxy-provider",
  "version": "0.5.0",
  "description": "CLIProxyAPI provider extension for OMP and pi.dev with automatic model discovery and models.dev enrichment.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "omp",
    "pi-package",
    "pi-extension",
    "cliproxyapi",
    "provider",
    "models.dev"
  ],
  "files": [
    "src",
    "extensions",
    "data",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "scripts": {
    "test": "bun test test/*.test.ts",
    "test:unit": "bun test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "update:models-dev": "node scripts/update-models-dev-fallback.mjs"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-ai": ">=17.0.0",
    "@oh-my-pi/pi-coding-agent": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "17.2.15",
    "@oh-my-pi/pi-coding-agent": "17.2.15",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  }
}